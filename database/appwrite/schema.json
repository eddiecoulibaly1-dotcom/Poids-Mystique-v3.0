{
  "backend": "appwrite",
  "product": "TablesDB",
  "schema_version": "1.0.0",
  "project_name": "Géomancie",
  "database": {
    "id": "geomancie",
    "name": "Géomancie"
  },
  "notes": [
    "Create the database and tables in Appwrite Console using this specification.",
    "Do not commit Appwrite API keys or server secrets.",
    "BodeDiop mappings are provisional until individually verified."
  ],
  "tables": [
    {
      "id": "sources",
      "name": "Sources",
      "row_security": true,
      "columns": {
        "name": {"type": "string", "required": true, "size": 255},
        "url": {"type": "string", "required": false, "size": 2000},
        "source_type": {"type": "string", "required": true, "size": 64},
        "citation_text": {"type": "string", "required": false, "size": 5000},
        "verification_status": {"type": "string", "required": true, "size": 32},
        "notes": {"type": "string", "required": false, "size": 5000}
      },
      "indexes": ["verification_status"]
    },
    {
      "id": "figures",
      "name": "Figures",
      "row_security": true,
      "columns": {
        "figure_number": {"type": "integer", "required": true},
        "canonical_name": {"type": "string", "required": true, "size": 100},
        "aliases_json": {"type": "string", "required": true, "size": 5000},
        "traditional_name": {"type": "string", "required": false, "size": 255},
        "element": {"type": "string", "required": false, "size": 32},
        "movement": {"type": "string", "required": false, "size": 64},
        "valence": {"type": "string", "required": false, "size": 64},
        "rest_house": {"type": "integer", "required": false},
        "source_id": {"type": "string", "required": false, "size": 64},
        "source_version": {"type": "string", "required": false, "size": 64},
        "verified": {"type": "boolean", "required": true}
      },
      "indexes": ["figure_number", "canonical_name", "verified"]
    },
    {
      "id": "maisons",
      "name": "Maisons",
      "row_security": true,
      "columns": {
        "house_number": {"type": "integer", "required": true},
        "canonical_name": {"type": "string", "required": true, "size": 100},
        "domain": {"type": "string", "required": true, "size": 255},
        "keywords_json": {"type": "string", "required": true, "size": 5000},
        "element": {"type": "string", "required": false, "size": 32},
        "movement": {"type": "string", "required": false, "size": 64},
        "description": {"type": "string", "required": false, "size": 5000},
        "source_id": {"type": "string", "required": false, "size": 64},
        "verified": {"type": "boolean", "required": true}
      },
      "indexes": ["house_number", "canonical_name", "verified"]
    },
    {
      "id": "figure_maison",
      "name": "Figure × Maison",
      "row_security": true,
      "columns": {
        "figure_id": {"type": "string", "required": true, "size": 64},
        "house_id": {"type": "string", "required": true, "size": 64},
        "source_text": {"type": "string", "required": false, "size": 10000},
        "concepts_json": {"type": "string", "required": true, "size": 10000},
        "source_id": {"type": "string", "required": false, "size": 64},
        "source_version": {"type": "string", "required": false, "size": 64},
        "confidence": {"type": "string", "required": true, "size": 32},
        "verified": {"type": "boolean", "required": true},
        "medical_or_ritual_content": {"type": "boolean", "required": true}
      },
      "indexes": ["figure_id", "house_id", "verified", "confidence"]
    },
    {
      "id": "themes",
      "name": "Themes",
      "row_security": true,
      "columns": {
        "user_id": {"type": "string", "required": false, "size": 64},
        "name": {"type": "string", "required": false, "size": 255},
        "mothers_json": {"type": "string", "required": true, "size": 20000},
        "theme_json": {"type": "string", "required": true, "size": 50000},
        "shadow_json": {"type": "string", "required": false, "size": 10000},
        "abjad_json": {"type": "string", "required": false, "size": 10000},
        "interactions_json": {"type": "string", "required": false, "size": 20000},
        "engine_version": {"type": "string", "required": true, "size": 64},
        "source_version": {"type": "string", "required": true, "size": 64},
        "status": {"type": "string", "required": true, "size": 32}
      },
      "indexes": ["user_id", "created_at", "engine_version"]
    },
    {
      "id": "interpretations",
      "name": "Interpretations",
      "row_security": true,
      "columns": {
        "theme_id": {"type": "string", "required": true, "size": 64},
        "section": {"type": "string", "required": true, "size": 64},
        "content": {"type": "string", "required": true, "size": 20000},
        "model": {"type": "string", "required": false, "size": 255},
        "prompt_version": {"type": "string", "required": false, "size": 64},
        "source_version": {"type": "string", "required": true, "size": 64},
        "generated_by": {"type": "string", "required": true, "size": 64}
      },
      "indexes": ["theme_id", "section", "created_at"]
    }
  ]
}
